{
  "name": "tallybard-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev --custom-args=\"--import=./instrument.mjs\"",
    "build": "mastra build",
    "start": "node --import=./.mastra/output/instrument.mjs .mastra/output/index.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "latest",
    "@ai-sdk/openai-compatible": "latest",
    "@mastra/core": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "@mastra/otel-bridge": "^1.5.17",
    "@mastra/pg": "latest",
    "ai": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@sentry/node": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "mastra": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
