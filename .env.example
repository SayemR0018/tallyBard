# Postgres connection string (read-only for the sidecar is fine)
DATABASE_URL=
# Read-write DSN for the API + migrations (Tiger read-only string minus the
# default_transaction_read_only option)
DATABASE_URL_RW=

# Model backend selector: ollama or aistudio
MODEL_BACKEND=

# Ollama base URL (Caddy-fronted, bearer-token protected)
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
# Ollama model tags
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=embeddinggemma

# Google AI Studio API key + model ids
GOOGLE_API_KEY=
AI_CHAT_MODEL=gemma-4-26b-a4b-it
AI_EMBED_MODEL=gemini-embedding-001

# Sentry DSN for tracing
SENTRY_DSN=
# LOCAL ONLY: 1 records genAI inputs/outputs for screenshots (synthetic data only)
SENTRY_CAPTURE_CONTENT=0

# URL for the risk sidecar service
RISK_SIDECAR_URL=
# local (open weights) | api (Prior Labs hosted, non-commercial key)
TABPFN_MODE=local

# Optional TabPFN token for API comparison only
TABPFN_TOKEN=

# Allowed web origin for CORS (comma-separated for multiple)
WEB_ORIGIN=http://localhost:5173
